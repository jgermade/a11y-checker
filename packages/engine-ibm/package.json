{
  "name": "@a11y-checker/engine-ibm",
  "version": "0.1.1",
  "description": "IBM Equal Access engine provider for a11y-checker.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./iife": "./dist/engine-ibm.iife.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsdown",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgermade/a11y-checker.git",
    "directory": "packages/engine-ibm"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@a11y-checker/core": "workspace:^",
    "accessibility-checker-engine": "^4.0.35"
  },
  "devDependencies": {
    "@a11y-checker/engine-axe": "workspace:^"
  }
}
