{
  "name": "@a11y-checker/cypress",
  "version": "0.1.1",
  "description": "Accessibility checks for Cypress: cy.checkA11y().",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/support.*"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./support": {
      "import": {
        "types": "./dist/support.d.ts",
        "default": "./dist/support.js"
      },
      "require": {
        "types": "./dist/support.d.cts",
        "default": "./dist/support.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "cypress": ">=12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgermade/a11y-checker.git",
    "directory": "packages/cypress"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@a11y-checker/core": "workspace:^",
    "@a11y-checker/sdk": "workspace:^"
  },
  "devDependencies": {
    "cypress": "16.4.0"
  }
}
